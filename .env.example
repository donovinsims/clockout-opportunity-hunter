# Copy to .env inside this project; .env is ignored by Git. Never paste keys into logs.
# Tavily is the default. Brave is attempted only when Tavily is absent, fails or returns no results.
TAVILY_API_KEY=
BRAVE_API_KEY=
# Optional short-lived Google access token for standalone sync. Codex connector auth is separate.
OPPORTUNITY_GOOGLE_ACCESS_TOKEN=
